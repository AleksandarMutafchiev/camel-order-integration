                  <groupId>org.example</groupId>
                  <artifactId>itests</artifactId>
                  <version>${parent.version}</version>
                  <classifier>tests</classifier>
                  <outputDirectory>${project.build.testOutputDirectory}</outputDirectory>
                </artifactItem>
              </artifactItems>
            </configuration>
          </execution>
        </executions>
      </plugin>-->
    </plugins>
  </build>

